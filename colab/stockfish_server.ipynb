   "source": [
    "## STEP 3 — Start FastAPI Server (Depth 30+)\n",
    "Launches the FastAPI backend service on `http://127.0.0.1:8000`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# STEP 3 — Start FastAPI Server in Background\n",
    "import os\n",
    "import time\n",
    "import subprocess\n",
    "import requests\n",
    "\n",
    "if not os.path.exists(\"backend\"):\n",
    "    print(\"📥 Fetching backend application files from GitHub...\")\n",
    "    # Set up workspace directory
import os
os.makedirs("/content/app", exist_ok=True)\n",
    "    if os.path.exists(\"/content/app/backend\"):\n",
    "        %cd /content/app\n",
    "\n",
    "print(\"🚀 Starting FastAPI server on http://127.0.0.1:8000...\")\n",
    "server_process = subprocess.Popen(\n",
    "    [\"python3\", \"-m\", \"uvicorn\", \"backend.app:app\", \"--host\", \"127.0.0.1\", \"--port\", \"8000\"],\n",
    "    stdout=subprocess.PIPE,\n",
    "    stderr=subprocess.PIPE\n",
    ")\n",
    "\n",
    "time.sleep(3)\n",
    "try:\n",
    "    r = requests.get(\"http://127.0.0.1:8000/api/health\", timeout=3)\n",
    "    if r.status_code == 200:\n",
    "        print(\"✅ FastAPI Server is running locally:\", r.json())\n",
    "        print(\"✅ STEP 3 Complete.\")\n",
    "    else:\n",
    "        print(\"⚠️ Server returned status:\", r.status_code)\n",
    "except Exception as e:\n",
    "    print(\"⚠️ Server starting...\", e)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## STEP 4 — Launch Public Cloudflare Tunnel\n",
    "Exposes FastAPI publicly over HTTPS via Cloudflare Tunnel."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# STEP 4 — Cloudflare Tunnel Launch\n",
    "import re\n",
    "import time\n",
    "import subprocess\n",
    "\n",
    "print(\"🌐 Opening Cloudflare Tunnel...\")\n",
    "tunnel_process = subprocess.Popen(\n",
    "    [\"/usr/local/bin/cloudflared\", \"tunnel\", \"--url\", \"http://127.0.0.1:8000\"],\n",
    "    stdout=subprocess.PIPE,\n",
    "    stderr=subprocess.STDOUT,\n",
    "    text=True\n",
    ")\n",
    "\n",
    "public_url = None\n",
    "start_time = time.time()\n",
    "\n",
    "while time.time() - start_time < 30:\n",
    "    line = tunnel_process.stdout.readline()\n",
    "    if not line:\n",
    "        time.sleep(0.5)\n",
    "        continue\n",
    "    if \"trycloudflare.com\" in line:\n",
    "        match = re.search(r\"https://[a-zA-Z0-9-]+\\.trycloudflare\\.com\", line)\n",
    "        if match:\n",
    "            public_url = match.group(0)\n",
    "            break\n",
    "\n",
    "if public_url:\n",
    "    print(\"\\n\" + \"=\" * 50)\n",
    "    print(\"🏆 STOCKFISH 19 GPU (DEPTH 30+) SERVER IS LIVE!\")\n",
    "    print(\"=\" * 50)\n",
    "    print(f\"Local URL : http://127.0.0.1:8000\")\n",
    "    print(f\"Public URL: {public_url}\")\n",
    "    print(\"=\" * 50)\n",
    "    print(f\"👉 Copy '{public_url}' and paste it into Settings -> Colab Server URL in your Render App.\")\n",
    "    print(\"=\" * 50 + \"\\n\")\n",
    "else:\n",
    "    print(\"❌ Tunnel creation timed out. Please re-run STEP 4.\")"
   ]
  },
  {
   "cell_type": "markdown",
