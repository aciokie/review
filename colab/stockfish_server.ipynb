   "source": [
    "## STEP 5 — Server Keep-Alive & Health Polling\n",
    "Performs continuous health checks for Colab session keep-alive."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# STEP 5 — Health Check Keep-Alive\n",
    "import time\n",
    "import requests\n",
    "from datetime import datetime\n",
    "\n",
    "print(\"🔄 Starting keep-alive polling loop. Press Stop in Colab to terminate server.\")\n",
    "poll_count = 0\n",
    "\n",
    "try:\n",
    "    while True:\n",
    "        time.sleep(30)\n",
    "        poll_count += 1\n",
    "        now = datetime.now().strftime(\"%H:%M:%S\")\n",
    "        try:\n",
    "            res = requests.get(\"http://127.0.0.1:8000/api/health\", timeout=2)\n",
    "            if res.status_code == 200:\n",
    "                print(f\"[{now}] Heartbeat #{poll_count}: Stockfish 19 Depth 30+ Engine Active\")\n",
    "            else:\n",
    "                print(f\"[{now}] Warning: Health check returned {res.status_code}\")\n",
    "        except Exception as err:\n",
    "            print(f\"[{now}] Connection check warning: {err}\")\n",
    "except KeyboardInterrupt:\n",
    "    print(\"🛑 Server keep-alive stopped.\")"
   ]
  }
